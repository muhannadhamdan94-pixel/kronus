{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/guides/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
